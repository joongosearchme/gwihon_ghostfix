<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>GhostFix</AssemblyName>
    <RootNamespace>GhostFix</RootNamespace>
    <LangVersion>11.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- exe 속성(파일 정보)에 보이는 값. v1.1.1 같은 태그로 배포하면 버전은 그 번호로 바뀐다 -->
  <PropertyGroup>
    <Version>1.2.1</Version>
    <AssemblyTitle>GhostFix</AssemblyTitle>
    <Product>GhostFix</Product>
    <Description>귀혼 game.exe LAA / 호환성 / 자동 유지 관리 설정 도구</Description>
    <Company>joongosearch.me</Company>
    <Copyright>© 2026 joongosearch.me</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.8 대상 팩이 없는 PC·리눅스에서도 빌드되게 한다 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" /><!-- 작업 스케줄러 COM을 dynamic으로 다룬다 -->
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web.Extensions" /><!-- 새 버전 확인 응답(JSON)을 읽는다 -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
